{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "typeorm:migrate": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "typeorm:migrate:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.7",
    "@nestjs/core": "^10.2.7",
    "@nestjs/platform-express": "^10.2.7",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "typeorm": "^0.3.20",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.3",
    "@nestjs/schematics": "^10.2.1",
    "@nestjs/testing": "^10.2.7",
    "typescript": "^5.4.5",
    "@types/node": "^20.10.5",
    "@types/passport-jwt": "^3.0.8",
    "@types/bcryptjs": "^2.4.2",
    "ts-node": "^10.9.1"
  }
}
